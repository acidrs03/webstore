<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/admin/head') %></head>
<body>
<div class="admin-wrapper">
  <%- include('../../partials/admin/sidebar') %>
  <main class="admin-main">
    <div class="admin-topbar">
      <h4 class="mb-0"><%= isNew ? 'New Admin User' : 'Edit: ' + admin.name %></h4>
      <a href="/admin/admins" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
      </a>
    </div>
    <div class="admin-content">
      <%- include('../../partials/flash') %>

      <div class="row justify-content-center">
        <div class="col-lg-7">
          <form action="<%= isNew ? '/admin/admins' : '/admin/admins/' + admin._id %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- Account Details -->
            <div class="card border-0 shadow-sm mb-4">
              <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-semibold">Account Details</h6>
              </div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="name" name="name" value="<%= admin.name || '' %>" required maxlength="100">
                  </div>
                  <div class="col-md-6">
                    <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="email" name="email" value="<%= admin.email || '' %>" required>
                  </div>
                  <div class="col-md-6">
                    <label for="password" class="form-label">
                      Password <% if (!isNew) { %><span class="text-muted small">(leave blank to keep current)</span><% } else { %><span class="text-danger">*</span><% } %>
                    </label>
                    <input type="password" class="form-control" id="password" name="password" minlength="8" <%= isNew ? 'required' : '' %> autocomplete="new-password" placeholder="Min. 8 characters">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label d-block">Status</label>
                    <div class="form-check form-switch mt-2">
                      <input class="form-check-input" type="checkbox" id="isActive" name="isActive" value="on" <%= isNew || admin.isActive !== false ? 'checked' : '' %>>
                      <label class="form-check-label" for="isActive">Active (can log in)</label>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Role & Permissions -->
            <div class="card border-0 shadow-sm mb-4">
              <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-semibold">Role & Permissions</h6>
              </div>
              <div class="card-body">
                <div class="mb-4">
                  <label class="form-label fw-semibold">Role</label>
                  <div class="d-flex gap-3">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="role" id="roleAdmin" value="admin" <%= (!admin.role || admin.role === 'admin') ? 'checked' : '' %>>
                      <label class="form-check-label" for="roleAdmin">
                        <span class="fw-semibold">Admin</span>
                        <div class="text-muted small">Access is limited to the permissions selected below.</div>
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="role" id="roleSuperAdmin" value="superadmin" <%= admin.role === 'superadmin' ? 'checked' : '' %>>
                      <label class="form-check-label" for="roleSuperAdmin">
                        <span class="fw-semibold">Super Admin</span>
                        <div class="text-muted small">Full access to everything, including admin user management.</div>
                      </label>
                    </div>
                  </div>
                </div>

                <div id="permissionsSection" class="<%= admin.role === 'superadmin' ? 'd-none' : '' %>">
                  <label class="form-label fw-semibold">Permissions</label>
                  <p class="text-muted small mb-3">Choose which sections this admin can access. Menu items for unselected sections will be hidden from them.</p>
                  <div class="row g-2">
                    <% Object.entries(PERMISSIONS).forEach(function([key, perm]) { %>
                    <div class="col-md-6">
                      <div class="form-check border rounded p-3 m-0 h-100">
                        <input class="form-check-input" type="checkbox" name="permissions" value="<%= key %>" id="perm_<%= key %>"
                          <%= admin.permissions && admin.permissions.includes(key) ? 'checked' : '' %>>
                        <label class="form-check-label w-100" for="perm_<%= key %>">
                          <span class="fw-semibold d-block"><%= perm.label %></span>
                          <span class="text-muted small"><%= perm.description %></span>
                        </label>
                      </div>
                    </div>
                    <% }); %>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-dark px-4">
                <i class="bi bi-check2 me-1"></i> Save
              </button>
              <a href="/admin/admins" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/admin.js"></script>
<script>
(function () {
  const radios = document.querySelectorAll('input[name="role"]');
  const section = document.getElementById('permissionsSection');
  radios.forEach(function (r) {
    r.addEventListener('change', function () {
      section.classList.toggle('d-none', this.value === 'superadmin');
    });
  });
})();
</script>
</body>
</html>

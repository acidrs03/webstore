<!DOCTYPE html>
<html lang="en">
<head><%- include('../../partials/admin/head') %></head>
<body>
<div class="admin-wrapper">
  <%- include('../../partials/admin/sidebar') %>
  <main class="admin-main">
    <div class="admin-topbar">
      <h4 class="mb-0">Admin Users</h4>
      <a href="/admin/admins/new" class="btn btn-sm btn-dark">
        <i class="bi bi-plus-lg me-1"></i> New Admin User
      </a>
    </div>
    <div class="admin-content">
      <%- include('../../partials/flash') %>

      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover mb-0 admin-table">
            <thead class="table-light">
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Permissions</th>
                <th>Status</th>
                <th>Last Login</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% admins.forEach(function(admin) { %>
              <tr>
                <td class="fw-semibold"><%= admin.name %></td>
                <td class="text-muted small"><%= admin.email %></td>
                <td>
                  <% if (admin.role === 'superadmin') { %>
                    <span class="badge bg-dark">Super Admin</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Admin</span>
                  <% } %>
                </td>
                <td class="small text-muted">
                  <% if (admin.role === 'superadmin') { %>
                    <em>All permissions</em>
                  <% } else if (admin.permissions && admin.permissions.length > 0) { %>
                    <%= admin.permissions.join(', ') %>
                  <% } else { %>
                    <em class="text-danger">None</em>
                  <% } %>
                </td>
                <td>
                  <span class="badge <%= admin.isActive ? 'bg-success' : 'bg-secondary' %>">
                    <%= admin.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td class="text-muted small">
                  <%= admin.lastLoginAt ? admin.lastLoginAt.toLocaleDateString() : 'Never' %>
                </td>
                <td class="text-end">
                  <a href="/admin/admins/<%= admin._id %>/edit" class="btn btn-xs btn-outline-secondary me-1">Edit</a>
                  <% if (admin._id.toString() !== adminUser.id.toString()) { %>
                  <form action="/admin/admins/<%= admin._id %>/delete" method="POST" class="d-inline"
                        onsubmit="return confirm('Delete <%= admin.name %>? This cannot be undone.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-xs btn-outline-danger">Delete</button>
                  </form>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
